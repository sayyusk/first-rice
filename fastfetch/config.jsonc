{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": { "1": "38;2;156;195;227" },
    "padding": { "top": 1, "left": 2, "right": 4 }

    // ── want your wallpaper / Rei as the logo instead? swap the block above for this
    // (works in kitty; for other terminals use "sixel" or "chafa"):
    // "type": "kitty-direct",
    // "source": "~/Pictures/rei.png",
    // "width": 30,
    // "height": 16,
    // "padding": { "top": 1, "left": 2, "right": 3 }
  },

  "display": {
    "separator": " ",
    "color": {
      "title": "38;2;156;195;227",
      "keys": "38;2;156;195;227",
      "separator": "38;2;110;130;150",
      "output": "38;2;228;237;245"
    },
    "percent": { "type": 3 },
    "size": { "binaryPrefix": "iec" }
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;2;228;237;245",
        "at": "38;2;110;130;150",
        "host": "38;2;156;195;227"
      }
    },
    { "type": "separator", "string": "─" },

    { "type": "os",       "key": "  os      " },
    { "type": "host",     "key": "  host    " },
    { "type": "kernel",   "key": "  kernel  " },
    { "type": "uptime",   "key": "  uptime  " },
    { "type": "packages", "key": "  pkgs    " },
    { "type": "shell",    "key": "  shell   " },

    "break",

    { "type": "wm",        "key": "  wm      " },
    { "type": "terminal",  "key": "  term    " },
    { "type": "font",      "key": "  font    " },

    "break",

    { "type": "cpu",     "key": "  cpu     " },
    { "type": "gpu",     "key": "  gpu     " },
    { "type": "memory",  "key": "  memory  " },
    { "type": "disk",    "key": "  disk    ", "folders": "/" },
    { "type": "battery", "key": "  battery " },
    { "type": "wifi",    "key": "  wifi    " },

    "break",

    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
