[
{
"name": "main",
"layer": "top",
"position": "top",
"exclusive": true,
"height": 30,
"modules-left": [
  "cpu",
  "memory",
  "cava",
  "custom/scroll"
],
"modules-center": [
  "hyprland/workspaces"
],
"modules-right": [
  "bluetooth",
  "network",
  "battery",
  "clock"
],

"cpu": {
  "format": "{icon}  {usage}%",
  "format-icons": [""],
  "interval": 2
},

"memory": {
  "format": "{icon}  {percentage}%",
  "format-icons": [""],
  "interval": 5,
  "tooltip-format": "{used} / {total} GiB"
},

"cava": {
  "framerate": 30,
  "bars": 10,
  "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
  "bar_delimiter": 0,
  "hide_on_silence": false
},

"custom/scroll": {
  "exec": "$HOME/.config/waybar/scripts/scroll.py",
  "format": "{}",
  "escape": true
},

"hyprland/workspaces": {
  "format": "{id}",
  "on-click": "activate",
  "all-outputs": true,
  "persistent-workspaces": {
    "*": 5
  }
},

"bluetooth": {
  "format": "󰂯",
  "format-disabled": "󰂲",
  "format-off": "󰂲",
  "format-on": "󰂯",
  "format-connected": "󰂱 {num_connections}",
  "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
  "tooltip-format": "{controller_alias}\n{num_connections} connected",
  "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
  "tooltip-format-enumerate-connected": "{device_alias}",
  "tooltip-format-enumerate-connected-battery": "{device_alias}: {device_battery_percentage}%",
  "interval": 5
},

"network": {
  "format-wifi": "{icon}",
  "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
  "format-ethernet": "󰈀",
  "format-disconnected": "󰤮",
  "tooltip-format-wifi": "{essid}",
  "tooltip-format-ethernet": "Ethernet: {ifname}",
  "tooltip-format-disconnected": "Not connected"
},

"battery": {
  "format": "{icon} {capacity}%",
  "format-charging": "󰂄 {capacity}%",
  "format-discharging": "{icon} {capacity}%",
  "format-full": "󰁹 {capacity}%",
  "format-icons": [
    "󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾",
    "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
  ],
  "tooltip-format": "{time}",
  "interval": 30
},

"clock": {
  "format": "{:%H:%M:%S}",
  "format-alt": "{:%d/%m/%Y}",
  "interval": 1,
  "tooltip-format": "<tt>{calendar}</tt>",
  "calendar": {
    "mode": "month",
    "weeks-pos": "right",
    "on-scroll": 1,
    "format": {
      "months": "<span><b>{}</b></span>",
      "days": "<span>{}</span>",
      "weeks": "<span>W{}</span>",
      "weekdays": "<span>{}</span>",
      "today": "<span><b><u>{}</u></b></span>"
    }
  },
  "actions": {
    "on-click-right": "mode",
    "on-scroll-up": "shift_up",
    "on-scroll-down": "shift_down"
  }
}
}
]
