[
  {
    "name": "main",
    "layer": "top",
"layer": "top",
"position": "top",
"exclusive": true,
"height": 26
    "modules-left": ["cpu", "memory", "cava", "custom/scroll"],
    "modules-right": ["bluetooth", "network", "battery", "clock"],

    "cpu": {
      "format": "{icon}  {usage}%",
      "format-icons": [""],
      "interval": 2
    },
    "memory": {
      "format": "{icon} {percentage}%",
      "format-icons": [""],
      "interval": 5,
      "tooltip-format": "{used} / {total} GiB"
    },
    "cava": {
      "framerate": 30,
      "bars": 10,
      "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
      "bar_delimiter": 0,
      "hide_on_silence": true
    },
    "custom/scroll": {
      "exec": "$HOME/.config/waybar/scripts/scroll.py",
      "format": "{}",
      "escape": true
    },
    "bluetooth": {},
    "network": {
      "format-wifi": "{icon}",
      "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
      "format-ethernet": "󰈀",
      "format-disconnected": "󰤮",
      "tooltip-format-wifi": "{essid}",
      "tooltip-format-ethernet": "Ethernet: {ifname}",
      "tooltip-format-disconnected": "Not connected"
    },
    "battery": {
      "format": "{icon} {percentage}%",
      "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "format-charging": "󰂄",
      "tooltip-format": "{timeTo}",
      "interval": 30
    },
    "clock": {
      "format": "{:%H:%M:%S}",
      "format-alt": "{:%d/%m/%Y}",
      "interval": 1,
      "tooltip-format": "<tt>{calendar}</tt>",
      "calendar": {
        "mode": "month",
        "weeks-pos": "right",
        "on-scroll": 1,
        "format": {
          "months": "<span color='#89b4fa'><b>{}</b></span>",
          "days": "<span color='#cdd6f4'>{}</span>",
          "weeks": "<span color='#6c7086'>W{}</span>",
          "weekdays": "<span color='#f9e2af'>{}</span>",
          "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
        }
      },
      "actions": {
        "on-click-right": "mode",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
      }
    }
  },
 {
  "name": "tab",
  "layer": "top",
  "position": "top",
  "exclusive": false,
  "passthrough": false,
  "height": 30,
  "width": 240,
  "margin-top": 0,
  "modules-center": ["hyprland/workspaces"],
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "all-outputs": true,
    "persistent-workspaces": {
      "*": 5
    }
  }
}
]
